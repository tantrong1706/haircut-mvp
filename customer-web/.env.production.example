VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_REGION=asia-southeast1
VITE_ZALO_MINI_APP_ID=your-zalo-mini-app-id
VITE_FIREBASE_APP_CHECK_SITE_KEY=
VITE_APP_ENV=production

# Không đổi giá trị này trong bản production.
VITE_FUNCTION_WRITE_MODE=required
VITE_MONITORING_DISABLED=false
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAY_SAMPLE_RATE=0
VITE_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0.1
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=your-support-phone
