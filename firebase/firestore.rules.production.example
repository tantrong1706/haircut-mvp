rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Draft only. Do not deploy until owner/staff/customer auth is implemented.
    match /customers/{customerId} {
      allow read, write: if request.auth != null;
    }

    match /chair_sessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    match /point_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /haircut_records/{recordId} {
      allow read, write: if request.auth != null;
    }

    match /lucky_wheel/{salonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reward_history/{rewardId} {
      allow read, write: if request.auth != null;
    }
  }
}

