rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isActiveMember(salonId) {
      return signedIn()
        && userDoc().data.salonId == salonId
        && userDoc().data.isActive == true;
    }

    match /salons/{salonId}/customers/{customerId}/{allPaths=**} {
      allow read, write: if isActiveMember(salonId);
    }
  }
}

