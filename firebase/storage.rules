rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userExists() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function salonPath(salonId) {
      return /databases/(default)/documents/salons/$(salonId);
    }

    function salonOperational(salonId) {
      return firestore.exists(salonPath(salonId))
        && (
          !("isActive" in firestore.get(salonPath(salonId)).data)
          || firestore.get(salonPath(salonId)).data.isActive == true
        )
        && (
          !("status" in firestore.get(salonPath(salonId)).data)
          || firestore.get(salonPath(salonId)).data.status == "active"
        );
    }

    function photoUploadEnabled(salonId) {
      let systemPath = /databases/(default)/documents/system_config/features;
      let salonFeaturePath = /databases/(default)/documents/salons/$(salonId)/settings/features;
      return (
          !firestore.exists(systemPath)
          || !("maintenanceMode" in firestore.get(systemPath).data)
          || firestore.get(systemPath).data.maintenanceMode == false
        )
        && (
          !firestore.exists(systemPath)
          || !("photoUploadEnabled" in firestore.get(systemPath).data)
          || firestore.get(systemPath).data.photoUploadEnabled == true
        )
        && (
          !firestore.exists(salonFeaturePath)
          || !("maintenanceMode" in firestore.get(salonFeaturePath).data)
          || firestore.get(salonFeaturePath).data.maintenanceMode == false
        )
        && (
          !firestore.exists(salonFeaturePath)
          || !("photoUploadEnabled" in firestore.get(salonFeaturePath).data)
          || firestore.get(salonFeaturePath).data.photoUploadEnabled == true
        );
    }

    function isActiveMember(salonId) {
      return userExists()
        && userDoc().data.salonId == salonId
        && userDoc().data.isActive == true
        && (
          userDoc().data.role != "staff"
          || !("inviteStatus" in userDoc().data)
          || userDoc().data.inviteStatus == "accepted"
        )
        && salonOperational(salonId);
    }

    function isOwner(salonId) {
      return isActiveMember(salonId)
        && userDoc().data.role == "owner";
    }

    function canAccessBranch(salonId, branchId) {
      let member = userDoc().data;
      return isActiveMember(salonId) && (
        member.role == "owner" || (member.role == "staff" && (
          ("branchIds" in member && member.branchIds is list && branchId in member.branchIds)
          || ("branchId" in member && member.branchId == branchId)
        ))
      );
    }

    function customerExists(customerId) {
      return firestore.exists(/databases/(default)/documents/customers/$(customerId));
    }

    function customerDoc(customerId) {
      return firestore.get(/databases/(default)/documents/customers/$(customerId));
    }

    function customerAllowsPhoto(salonId, customerId) {
      return customerExists(customerId)
        && customerDoc(customerId).data.salonId == salonId
        && customerDoc(customerId).data.allowPhoto == true;
    }

    function sessionExists(sessionId) {
      return firestore.exists(/databases/(default)/documents/chair_sessions/$(sessionId));
    }

    function sessionDoc(sessionId) {
      return firestore.get(/databases/(default)/documents/chair_sessions/$(sessionId));
    }

    function isAssignedSessionMember(salonId, customerId, sessionId) {
      return isActiveMember(salonId)
        && sessionExists(sessionId)
        && sessionDoc(sessionId).data.salonId == salonId
        && sessionDoc(sessionId).data.customerId == customerId
        && canAccessBranch(salonId, sessionDoc(sessionId).data.branchId)
        && sessionDoc(sessionId).data.assignedStaffId == request.auth.uid;
    }

    function isAssignedServingMember(salonId, customerId, sessionId) {
      return isAssignedSessionMember(salonId, customerId, sessionId)
        && sessionDoc(sessionId).data.status == "serving";
    }

    function isOwnerPendingApprovalSession(salonId, customerId, sessionId) {
      return isOwner(salonId)
        && sessionExists(sessionId)
        && sessionDoc(sessionId).data.salonId == salonId
        && sessionDoc(sessionId).data.customerId == customerId
        && sessionDoc(sessionId).data.status == "pending_approval";
    }

    function isAllowedHaircutPhoto(salonId, customerId, sessionId) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == "image/jpeg"
        && request.resource.metadata.salonId == salonId
        && request.resource.metadata.customerId == customerId
        && request.resource.metadata.sessionId == sessionId
        && request.resource.metadata.branchId == sessionDoc(sessionId).data.branchId
        && request.resource.metadata.uploaderUid == request.auth.uid;
    }

    function photoOperationExists(operationId) {
      return firestore.exists(
        /databases/(default)/documents/photo_upload_operations/$(operationId)
      );
    }

    function photoOperation(operationId) {
      return firestore.get(
        /databases/(default)/documents/photo_upload_operations/$(operationId)
      );
    }

    function isAllowedOperationPhoto(salonId, customerId, sessionId, operationId) {
      return photoOperationExists(operationId)
        && photoOperation(operationId).data.status in ["pending", "uploading"]
        && photoOperation(operationId).data.salonId == salonId
        && photoOperation(operationId).data.customerId == customerId
        && photoOperation(operationId).data.sessionId == sessionId
        && photoOperation(operationId).data.staffUid == request.auth.uid
        && photoOperation(operationId).data.storagePath
          == "salons/" + salonId + "/customers/" + customerId
            + "/sessions/" + sessionId + "/" + operationId + ".jpg"
        && photoOperation(operationId).data.expiresAt > request.time
        && sessionExists(sessionId)
        && canAccessBranch(salonId, sessionDoc(sessionId).data.branchId)
        && (
          !("approvalMode" in sessionDoc(sessionId).data)
          || sessionDoc(sessionId).data.approvalMode != "staff_confirmation"
          || (
            sessionDoc(sessionId).data.status == "pending_approval"
            && sessionDoc(sessionId).data.photoConsentGranted == true
            && sessionDoc(sessionId).data.expiresAt > request.time
          )
        )
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= photoOperation(operationId).data.expectedMaxBytes
        && request.resource.contentType == "image/jpeg"
        && request.resource.metadata.salonId == salonId
        && request.resource.metadata.branchId == photoOperation(operationId).data.branchId
        && request.resource.metadata.customerId == customerId
        && request.resource.metadata.sessionId == sessionId
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.metadata.operationId == operationId
        && request.resource.metadata.requestId == photoOperation(operationId).data.requestId;
    }

    function canReadOperationPhoto(salonId, customerId, sessionId) {
      let session = sessionDoc(sessionId).data;
      return customerAllowsPhoto(salonId, customerId)
        && session.salonId == salonId && session.customerId == customerId
        && canAccessBranch(salonId, session.branchId)
        && (
          userDoc().data.role == "owner"
          || ("assignedStaffId" in session && session.assignedStaffId == request.auth.uid)
          || ("approvalMode" in session && session.approvalMode == "staff_confirmation"
            && session.photoConsentGranted == true && resource.metadata.uploaderUid == request.auth.uid)
        );
    }

    function isAllowedAvatarUpload() {
      return request.resource != null
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isAllowedSalonAvatarUpload(salonId) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType == "image/webp"
        && request.resource.metadata.salonId == salonId
        && request.resource.metadata.ownerUid == request.auth.uid;
    }

    match /salons/{salonId}/customers/{customerId}/haircuts/{sessionId}/{fileName} {
      allow read: if customerAllowsPhoto(salonId, customerId)
        && (isOwner(salonId) || isAssignedSessionMember(salonId, customerId, sessionId));
      allow create: if (isAssignedServingMember(salonId, customerId, sessionId)
          || isOwnerPendingApprovalSession(salonId, customerId, sessionId))
        && customerAllowsPhoto(salonId, customerId)
        && photoUploadEnabled(salonId)
        && isAllowedHaircutPhoto(salonId, customerId, sessionId);
      allow update: if false;
      allow delete: if isOwner(salonId)
        || (
          isAssignedServingMember(salonId, customerId, sessionId)
          && resource.metadata.uploaderUid == request.auth.uid
        );
    }

    match /salons/{salonId}/customers/{customerId}/sessions/{sessionId}/{fileName} {
      allow read: if signedIn() && sessionExists(sessionId) && canReadOperationPhoto(salonId, customerId, sessionId);
      allow create: if fileName.matches('op-[a-f0-9]{40}\\.jpg')
        && photoUploadEnabled(salonId)
        && customerAllowsPhoto(salonId, customerId)
        && isAllowedOperationPhoto(
          salonId,
          customerId,
          sessionId,
          request.resource.metadata.operationId
        );
      allow update: if false;
      allow delete: if false;
    }

    match /salons/{salonId}/owner_avatars/{ownerUid}/{fileName} {
      allow read: if isActiveMember(salonId);
      allow create, update: if isOwner(salonId)
        && photoUploadEnabled(salonId)
        && request.auth.uid == ownerUid
        && fileName.matches('avatar(\\.(jpg|jpeg|png|webp))?')
        && isAllowedAvatarUpload();
      allow delete: if isOwner(salonId)
        && request.auth.uid == ownerUid;
    }

    match /salons/{salonId}/branding/{fileName} {
      allow read: if isActiveMember(salonId);
      allow create, update: if isOwner(salonId)
        && photoUploadEnabled(salonId)
        && fileName == "avatar.webp"
        && isAllowedSalonAvatarUpload(salonId);
      allow delete: if isOwner(salonId)
        && fileName == "avatar.webp";
    }
  }
}
