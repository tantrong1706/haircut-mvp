rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Production policy: every business write goes through Cloud Functions.
    // Customer-facing reads are also served by Zalo-verified Cloud Functions.
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function appUser() {
      return get(userPath()).data;
    }

    function isActiveMember(salonId) {
      return hasUserProfile()
        && appUser().salonId == salonId
        && appUser().isActive == true;
    }

    function isStaffOrOwner(salonId) {
      return isActiveMember(salonId)
        && (appUser().role == "owner" || appUser().role == "staff");
    }

    function isOwner(salonId) {
      return isActiveMember(salonId) && appUser().role == "owner";
    }

    function canAccessBranch(salonId, branchId) {
      return isOwner(salonId)
        || (
          isActiveMember(salonId)
          && appUser().role == "staff"
          && (
            (
              "branchIds" in appUser()
              && appUser().branchIds is list
              && branchId in appUser().branchIds
            )
            || ("branchId" in appUser() && appUser().branchId == branchId)
          )
        );
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || (
            hasUserProfile()
            && resource.data.salonId == appUser().salonId
            && appUser().role == "owner"
          )
        );
      allow create, update, delete: if false;
    }

    match /salons/{salonId} {
      allow read: if isStaffOrOwner(salonId);
      allow create, update, delete: if false;
    }

    match /mirrors/{mirrorId} {
      allow read: if isOwner(resource.data.salonId);
      allow create, update, delete: if false;
    }

    match /branches/{branchId} {
      allow read: if canAccessBranch(resource.data.salonId, branchId);
      allow create, update, delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isOwner(resource.data.salonId);
      allow create, update, delete: if false;
    }

    match /chair_sessions/{sessionId} {
      allow read: if canAccessBranch(resource.data.salonId, resource.data.branchId);
      allow create, update, delete: if false;
    }

    match /point_requests/{requestId} {
      allow read: if isOwner(resource.data.salonId);
      allow create, update, delete: if false;
    }

    match /haircut_records/{recordId} {
      allow read: if isOwner(resource.data.salonId);
      allow create, update, delete: if false;
    }

    match /lucky_wheel/{salonId} {
      allow read: if isOwner(salonId);
      allow create, update, delete: if false;
    }

    match /reward_history/{rewardId} {
      allow read: if isOwner(resource.data.salonId);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
