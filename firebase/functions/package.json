{
  "name": "haircut-functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier src test --write",
    "format:check": "prettier src test --check",
    "test": "vitest",
    "test:unit": "vitest run test/security.test.ts",
    "test:rules": "vitest run test/firestore.rules.test.ts",
    "seed:demo": "npm run build && node lib/seedDemo.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "firebase": "^12.10.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  }
}
