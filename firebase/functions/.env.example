# Active Customer Web configuration. Real secrets belong in Secret Manager.
CUSTOMER_WEB_CHECKIN_URL=https://app.chhaircutsalon.cc/checkin
ENFORCE_APP_CHECK=false
ADMIN_WRITE_OPERATIONS_ENABLED=false

# Retained legacy endpoints only; not customer Web login requirements.
# See docs/LEGACY_COMPATIBILITY.md before changing existing deployment bindings.
ZALO_MINI_APP_ID=your-mini-app-id
ZALO_APP_ID=your-zalo-app-id
ZALO_APP_SECRET=your-zalo-app-secret
ZALO_VERIFIER_MODE=gateway
ZALO_GATEWAY_URL=https://gateway.chhaircutsalon.cc
ZALO_GATEWAY_KEY_ID=primary-v1
ZALO_GATEWAY_HMAC_SECRET=managed-by-secret-manager
REQUIRE_ZALO_APP_CHECK=false
